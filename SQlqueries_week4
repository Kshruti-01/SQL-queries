Step 2:Allocate Subject
USE SubjectAllocation;
GO

DROP PROCEDURE IF EXISTS AllocateSubjects;
GO

CREATE PROCEDURE AllocateSubjects
AS
BEGIN
    -- Clear previous data
    DELETE FROM Allotments;
    DELETE FROM UnallottedStudents;

    DECLARE @StudentId INT, @SubjectId VARCHAR(10), @Seats INT, @Pref INT;
    DECLARE @Allocated BIT;

    DECLARE student_cursor CURSOR FOR
        SELECT StudentId FROM StudentDetails ORDER BY GPA DESC;

    OPEN student_cursor;
    FETCH NEXT FROM student_cursor INTO @StudentId;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @Pref = 1;
        SET @Allocated = 0;

        WHILE @Pref <= 3 AND @Allocated = 0
        BEGIN
            SELECT @SubjectId = SubjectId
            FROM StudentPreferences
            WHERE StudentId = @StudentId AND Preference = @Pref;

            IF @SubjectId IS NOT NULL
            BEGIN
                SELECT @Seats = RemainingSeats FROM SubjectDetails WHERE SubjectId = @SubjectId;

                IF @Seats > 0
                BEGIN
                    INSERT INTO Allotments (StudentId, SubjectId)
                    VALUES (@StudentId, @SubjectId);

                    UPDATE SubjectDetails
                    SET RemainingSeats = RemainingSeats - 1
                    WHERE SubjectId = @SubjectId;

                    SET @Allocated = 1;
                END
            END

            SET @Pref = @Pref + 1;
        END

        IF @Allocated = 0
        BEGIN
            INSERT INTO UnallottedStudents (StudentId) VALUES (@StudentId);
        END

        FETCH NEXT FROM student_cursor INTO @StudentId;
    END

    CLOSE student_cursor;
    DEALLOCATE student_cursor;
END;
GO

